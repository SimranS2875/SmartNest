# SmartNest Environment Configuration
# Copy this file to .env and adjust values as needed.

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Simulation settings
SIMULATION_NAME=smartnest_assignment_1_2

# MongoDB Atlas connection string (placeholder; put the real one in .env only)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
