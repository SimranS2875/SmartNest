# SmartNest Environment Configuration
# Copy this file to .env and adjust values as needed.

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Simulation settings
SIMULATION_NAME=smartnest_assignment_1_2

# MongoDB Atlas (Assignment: database layer).
# Put the REAL values in backend/.env only; .env is git-ignored. Never commit credentials.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
MONGODB_DATABASE=smartnest

# Optional tuning (defaults shown)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_MAX_POOL_SIZE=50
